root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{ts,tsx,json,css}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
csharp_style_namespace_declarations = file_scoped:suggestion
